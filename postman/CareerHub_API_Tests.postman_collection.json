            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"{{testJobId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/applications", "host": ["{{baseUrl}}"], "path": ["applications"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Status code is 409 for duplicate application', function () { pm.response.to.have.status(409); });"]
            }
          }]
        },
