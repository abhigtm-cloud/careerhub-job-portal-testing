          "name": "Get My Applications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }],
            "url": { "raw": "{{baseUrl}}/applications/mine", "host": ["{{baseUrl}}"], "path": ["applications", "mine"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "const body = pm.response.json();",
                "pm.test('applications is an array', function () { pm.expect(body.applications).to.be.an('array'); });"
              ]
            }
          }]
        }
      ]
