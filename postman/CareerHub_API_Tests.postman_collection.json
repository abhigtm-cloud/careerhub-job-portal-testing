            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Updated Role\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/jobs/{{createdJobId}}", "host": ["{{baseUrl}}"], "path": ["jobs", "{{createdJobId}}"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "const body = pm.response.json();",
                "pm.test('Title updated', function () { pm.expect(body.job.title).to.eql('Postman Updated Role'); });"
              ]
            }
          }]
        },
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }],
            "url": { "raw": "{{baseUrl}}/jobs/{{createdJobId}}", "host": ["{{baseUrl}}"], "path": ["jobs", "{{createdJobId}}"] }
